# Template for scripts/bucket-sync.sh. Copy it OUTSIDE the repo (e.g. ~/bucket-sync.env
# on the host that runs the sync) and fill it in. Never commit the filled-in copy.
#
# docker --env-file format: KEY=value, no quotes (quotes are kept literally), no `export`.
# Values map 1:1 onto each service's storage vars:
#   BUCKET -> *_BUCKET, ENDPOINT -> *_ENDPOINT, ACCESS_KEY_ID / SECRET_ACCESS_KEY / REGION,
#   S3_FORCE_PATH_STYLE -> *_FORCE_PATH_STYLE

# --- Source: prod (Railway bucket). Only ever read from. ---
SRC_BUCKET=
RCLONE_CONFIG_SRC_TYPE=s3
RCLONE_CONFIG_SRC_PROVIDER=Other
RCLONE_CONFIG_SRC_ENDPOINT=
RCLONE_CONFIG_SRC_ACCESS_KEY_ID=
RCLONE_CONFIG_SRC_SECRET_ACCESS_KEY=
RCLONE_CONFIG_SRC_REGION=auto
RCLONE_CONFIG_SRC_FORCE_PATH_STYLE=false
RCLONE_CONFIG_SRC_NO_CHECK_BUCKET=true

# --- Destination: target env bucket (e.g. hotbox v2 dry run, SeaweedFS). ---
DST_BUCKET=
RCLONE_CONFIG_DST_TYPE=s3
RCLONE_CONFIG_DST_PROVIDER=Other
RCLONE_CONFIG_DST_ENDPOINT=
RCLONE_CONFIG_DST_ACCESS_KEY_ID=
RCLONE_CONFIG_DST_SECRET_ACCESS_KEY=
RCLONE_CONFIG_DST_REGION=auto
RCLONE_CONFIG_DST_FORCE_PATH_STYLE=true
RCLONE_CONFIG_DST_NO_CHECK_BUCKET=true
