# Database
DATABASE_URL=postgresql://grails:grails_password@localhost:5433/grails
DB_MAX_CONNECTIONS=20
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6380
REDIS_TTL=3600

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_INDEX=ens_names
ELASTIC_USERNAME=admin
ELASTIC_PASSWORD=changeme

# Blockchain
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
CHAIN_ID=1
ENS_REGISTRAR_ADDRESS=0x57f1887a8BF19b14fC0dF6Fd9B2acc9Af147eA85
SEAPORT_ADDRESS=0x0000000000000068F116a894984e2DB1123eB395
START_BLOCK=19000000
CONFIRMATIONS=12

# OpenSea (optional)
OPENSEA_API_KEY=
OPENSEA_STREAM_URL=wss://stream.openseabeta.com/socket

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info

# JWT (optional)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Valuation feature
# OpenAI key powers name research (web search) + appraisal fallbacks.
OPENAI_API_KEY=
# OpenRouter key powers the per-channel LLM routing (DeepSeek, Grok, etc.).
OPENROUTER_API_KEY=
# DomDB (Web2 footprint) — both keys are sent server-side in the request body.
DOMDB_API_KEY_PUBLIC=
DOMDB_API_KEY_PRIVATE=
# Set to 'false' to disable the valuation endpoints entirely.
VALUATION_ENABLED=true

# Node Environment
NODE_ENV=development