# Database
DATABASE_URL=postgresql://grails:grails_password@localhost:5433/grails
DB_MAX_CONNECTIONS=20
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6380
REDIS_TTL=3600

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_INDEX=ens_names
ELASTIC_USERNAME=admin
ELASTIC_PASSWORD=changeme

# Blockchain
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
CHAIN_ID=1
ENS_REGISTRAR_ADDRESS=0x57f1887a8BF19b14fC0dF6Fd9B2acc9Af147eA85
SEAPORT_ADDRESS=0x0000000000000068F116a894984e2DB1123eB395
START_BLOCK=19000000
CONFIRMATIONS=12

# OpenSea (optional)
OPENSEA_API_KEY=
OPENSEA_STREAM_URL=wss://stream.openseabeta.com/socket

# Web Push notifications (optional; generate VAPID keys with `npx web-push generate-vapid-keys`)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:noreply@grails.market
WEB_PUSH_TTL_SECONDS=86400

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info

# JWT (optional)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Valuation feature
# OpenRouter powers all active LLM channels (name research, related terms,
# number variants, appraisal — DeepSeek/Grok). Required for generation.
OPENROUTER_API_KEY=
# OpenAI key is only used by the fallback 'other' channel (not on the default
# path); set it if you route a channel back to OpenAI.
OPENAI_API_KEY=
# web2-tld-data (Web2 footprint) — our custom lookup API. Sent server-side as the
# X-API-Key header. Base URL is optional and defaults to the production instance.
WEB2_TLD_DATA_API_KEY=
# WEB2_TLD_DATA_BASE_URL=
# NOTE: enabling/disabling valuations + tuning quotas/TTLs is now done live via the
# valuation_settings DB row (cat-admin → Valuation settings), not an env var.

# Node Environment
NODE_ENV=development
