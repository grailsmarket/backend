{
  "name": "@grails/api",
  "version": "1.0.0",
  "description": "Grails API Service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/api/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/run-migrations.ts",
    "migrate:dry-run": "tsx scripts/run-migrations.ts --dry-run",
    "migrate:force": "tsx scripts/run-migrations.ts --force",
    "import:poap": "tsx scripts/import-poap-links.ts",
    "cache": "npm run build && node dist/api/src/scripts/redis-cache.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.74",
    "@aws-sdk/client-s3": "^3.992.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.13.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@fastify/websocket": "^8.3.1",
    "@heroicons/react": "^2.2.0",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@types/jsonwebtoken": "^9.0.10",
    "ai": "^6.0.208",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.5.0",
    "fastify": "^4.25.2",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "pg-boss": "^9.0.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "sanitize-html": "^2.17.3",
    "siwe": "^3.0.0",
    "viem": "^2.7.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.5.10",
    "vitest": "^1.6.0"
  }
}
