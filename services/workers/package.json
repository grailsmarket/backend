{
  "name": "@grails/workers",
  "version": "1.0.0",
  "description": "Grails Async Worker Service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "script:bootstrap-validation": "tsx src/scripts/bootstrap-validation.ts",
    "preview-emails": "npm run build && node dist/workers/src/scripts/preview-emails.js"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "nodemailer": "^7.0.9",
    "pg-boss": "^9.0.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
